{
  "name": "nova-music",
  "version": "1.0.0",
  "description": "Nova Music — toute ta musique au même endroit",
  "author": "Nova",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pc": "vite build && electron .",
    "pc:exe": "vite build && electron-builder --win --publish never",
    "pc:linux": "vite build && electron-builder --linux AppImage --publish never",
    "pc:mac": "vite build && electron-builder --mac dmg --publish never",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "fr.nova.music",
    "productName": "Nova Music",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "!node_modules/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "NovaMusic-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Nova Music"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Audio"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.music"
    }
  }
}
